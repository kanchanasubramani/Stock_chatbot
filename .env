# --- API endpoints / models (safe to leave at defaults) ------------------
ALPHA_VANTAGE_BASE_URL=https://www.alphavantage.co/query
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Cost / safety limits --------------------------------------------------
MAX_OUTPUT_TOKENS=200
MAX_INPUT_CHARS=200

# --- RAG (document retrieval) ----------------------------------------------
DOCUMENTS_DIR=data/documents
EMBEDDINGS_CACHE_DIR=data/embeddings_cache
RAG_CHUNK_SIZE_TOKENS=400
RAG_CHUNK_OVERLAP_TOKENS=50
RAG_TOP_K=4
RAG_MAX_CONTEXT_TOKENS=800
RAG_MIN_SIMILARITY=0.15
RAG_MAX_DOCUMENTS_PER_SYMBOL=10
RAG_MAX_TOTAL_MB_PER_SYMBOL=100

# --- Conversation memory (rolling-window summarization) ---------------------
CHAT_ROLLING_WINDOW_TURNS=3

# --- Guardrails (used via config.SETTINGS) ----------------------------------
MAX_PDF_FILES=5
MAX_PDF_MB=20
MAX_PDF_PAGES=300
QUESTION_MAX_CHARS=200
MIN_SECONDS_BETWEEN_REQUESTS=2
MAX_QUESTIONS_PER_SESSION=50
ENABLE_MODERATION=true
REQUEST_TIMEOUT_SECONDS=10
MAX_CHAT_TURNS=10
